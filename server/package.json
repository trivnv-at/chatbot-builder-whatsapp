{
  "name": "chatbot-flow-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint src",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "bullmq": "^5.34.10",
    "dotenv": "^16.4.7",
    "fastify": "^4.29.1",
    "ioredis": "^5.4.2",
    "jexl": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jexl": "^2.3.4",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
